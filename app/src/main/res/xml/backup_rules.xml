<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: GPL-3.0-or-later

  The same rule as data_extraction_rules.xml, for Android 11 and older, which read this file instead: nothing is
  uploaded to Google's cloud backup. (ACK's minimum is Android 12, so this is only a safety net that keeps the two
  files saying the same thing.)
  This file is checked by tools/freeform_studio/tests/test_sovereignty_policy.py.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
