    <string name="plain_words_switch_on">EENVOUDIGE WOORDE: AAN</string>
    <string name="plain_words_switch_off">EENVOUDIGE WOORDE: AF</string>
    <string name="plain_words_explanation">WANNEER DIT AAN IS, WYS ACK ALLEDAAGSE NAME IN PLEK VAN SY EIE WOORDE (BYVOORBEELD MENSE EN PLEKKE IN PLEK VAN TEIKENREKENAAR) EN WYS KNOPPIES VIR DINGE WAT ANDERS \'N GETIKTE OPDRAG NODIG HET, SOOS STUUR STIL. NIKS VERANDER HOE \'N BOODSKAP UITGAAN NIE, TENSY JY EEN VAN DIE KNOPPIES AANSKAKEL. DIT WERK DADELIK EN DIE GETIKTE OPDRAGTE BLY WERK.</string>
    <string name="plain_words_offer">NUUT: EENVOUDIGE WOORDE WYS ALLEDAAGSE NAME VIR ACK SE EIE WOORDE, EN KNOPPIES VIR DINGE WAT \'N GETIKTE OPDRAG NODIG HET. DIT IS AF EN NIKS VERANDER TENSY JY DIT AANSKAKEL.</string>
