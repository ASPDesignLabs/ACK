    <!-- PLAIN WORDS switch (SETTINGS, top). Worded the same in both modes on purpose, so it can always be found: it never goes through the label table. -->
    <string name="plain_words_switch_on">PLAIN WORDS: ON</string>
    <string name="plain_words_switch_off">PLAIN WORDS: OFF</string>
    <string name="plain_words_explanation">WHEN ON, ACK SHOWS EVERYDAY NAMES INSTEAD OF ITS OWN WORDS (FOR EXAMPLE PEOPLE AND PLACES INSTEAD OF TARGET COMPUTER), AND SHOWS BUTTONS FOR THINGS THAT OTHERWISE NEED A TYPED COMMAND, SUCH AS SEND QUIETLY. NOTHING CHANGES HOW A MESSAGE GOES OUT UNLESS YOU TURN ONE OF THOSE ON. IT TAKES EFFECT AT ONCE, AND THE TYPED COMMANDS KEEP WORKING.</string>
    <string name="plain_words_offer">NEW: PLAIN WORDS SHOWS EVERYDAY NAMES FOR ACK\'S OWN WORDS, AND BUTTONS FOR THINGS THAT NEED A TYPED COMMAND. IT IS OFF AND NOTHING CHANGES UNLESS YOU TURN IT ON.</string>
    <string name="plain_words_turn_on">TURN ON</string>
    <string name="plain_words_not_now">NOT NOW</string>

