# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/
app/build
wear/build

# Local configuration file (contains SDK path)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches

# Keystore files (CRITICAL: NEVER UPLOAD THESE)
*.jks
*.keystore
*.p12
*.key

# Google Services (If you use Firebase/Analytics)
google-services.json

# External Native Build (C++)
.cxx/

# Local Archives
*.zip
*.rar
*.7z

# Map Components
*.map

# Python bytecode cache (from tools/*.py scripts)
__pycache__/
*.pyc

# Vendored sherpa-onnx native library and its shared phonemization data --
# both are external binaries fetched manually (see app/libs/README.md and
# app/src/main/assets/espeak-ng-data/README.md), not committed to the repo.
app/libs/*.aar
app/src/main/assets/espeak-ng-data/*
!app/src/main/assets/espeak-ng-data/README.md
